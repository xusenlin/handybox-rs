import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { PageHeader } from "../components/page_header.slint";
import { AddressCard } from "../components/address_card.slint";
import { SharePanel } from "../components/share_panel.slint";
import { DropZone } from "../components/drop_zone.slint";
import { ShareAction } from "../components/share_action.slint";
import { ShareTheme } from "../components/share_theme.slint";
import { Icon } from "../components/icon.slint";
import { Icons } from "../icons.slint";
import { ShareState } from "../state/share.slint";

export component SharePage inherits Rectangle {
    in property <bool> busy;
    in property <bool> dragging;
    background: ShareTheme.canvas;
    // The two cards in the left column always stand in a 1.2 : 1 (text : drop)
    // ratio: giving the text card the leftover height instead made it swallow
    // the whole window on a full-screen display while the drop card stayed put.
    // The floor is the shortest the drop card can be drawn at; below it the
    // column keeps that height and the ScrollView scrolls.
    property <length> stack-gap: 16px;
    property <length> drop-floor: 200px;
    property <length> stack-height: max(controls.visible-height, root.drop-floor * 2.2 + root.stack-gap);
    VerticalLayout {
        padding: 24px; spacing: 16px;
        HorizontalLayout {
            spacing: 20px;
            PageHeader { horizontal-stretch: 1; heading: I18n.share-title; description: I18n.share-description; badge: ""; }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                ShareAction {
                    label: ShareState.sharing ? I18n.share-stop : I18n.share-start;
                    icon: ShareState.sharing ? Icons.stop : Icons.play;
                    // Starting is the primary (white-on-accent) button; stopping
                    // is a plain one, so the stop square carries the warning.
                    icon-ink: ShareState.sharing ? Theme.error : white;
                    primary: !ShareState.sharing;
                    enabled: !root.busy && !ShareState.starting;
                    clicked => { if ShareState.sharing { ShareState.stop(); } else { ShareState.start(); } }
                }
            }
        }
        AddressCard {
            sharing: ShareState.sharing;
            reachable: ShareState.reachable;
            address: ShareState.address;
            qr: ShareState.qr;
            has-qr: ShareState.has-qr;
            status: ShareState.status;
            copy-address => { ShareState.copy-address(); }
            open-browser => { ShareState.open-browser(); }
        }
        HorizontalLayout {
            spacing: 20px; vertical-stretch: 1; min-height: 260px;
            // Only the input column scrolls at short window heights; the file
            // list keeps its own virtualized viewport and accessible footer.
            controls := ScrollView {
                width: 300px; horizontal-stretch: 0;
                viewport-width: self.visible-width;
                viewport-height: root.stack-height;
                left-column := VerticalLayout {
                    width: controls.visible-width; height: controls.viewport-height;
                    spacing: root.stack-gap; padding-right: 12px;
                    DropZone {
                        height: (root.stack-height - root.stack-gap) / 2.2;
                        sharing: ShareState.sharing;
                        busy: root.busy;
                        dragging: root.dragging;
                        choose => { ShareState.choose-files(); }
                    }
                    Rectangle {
                        vertical-stretch: 1; min-height: 216px;
                        border-radius: ShareTheme.radius; border-width: 1px;
                        border-color: ShareTheme.border; background: Theme.surface;
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 9px;
                                Icon { source: Icons.document; ink: ShareTheme.accent; width: 18px; }
                                Text { text: I18n.share-text-title; font-size: 14px; font-weight: 700; color: ShareTheme.ink; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Rectangle {
                                vertical-stretch: 1; min-height: 76px;
                                border-radius: 10px; border-width: 1px; border-color: ShareTheme.border; background: Theme.canvas;
                                draft := TextInput {
                                    x: 11px; y: 10px;
                                    width: parent.width - 22px; height: parent.height - 20px;
                                    text <=> ShareState.draft;
                                    color: ShareTheme.ink; font-size: 12px;
                                    wrap: word-wrap; single-line: false;
                                    accessible-label: I18n.share-text-title;
                                }
                                if ShareState.draft == "": Text {
                                    x: 12px; y: 10px; width: parent.width - 24px;
                                    text: I18n.share-text-placeholder;
                                    color: ShareTheme.muted; font-size: 12px; wrap: word-wrap;
                                }
                            }
                            Text { text: I18n.share-text-hint; color: ShareTheme.muted; font-size: 10px; wrap: word-wrap; min-width: 0px; }
                            ShareAction {
                                label: I18n.share-save-text; icon: Icons.arrow-right; primary: true; horizontal-stretch: 1;
                                enabled: ShareState.can-save-text && ShareState.draft != "" && !root.busy;
                                clicked => { ShareState.save-text(); }
                            }
                        }
                    }
                }
            }
            SharePanel {
                horizontal-stretch: 1;
                rows: ShareState.files; has-files: ShareState.has-files;
                sharing: ShareState.sharing; busy: root.busy;
                summary: ShareState.summary; error: ShareState.list-error;
                folder: ShareState.folder; starting: ShareState.starting;
                choose-folder => { ShareState.choose-folder(); }
                open-folder => { ShareState.open-folder(); }
                view(index) => { ShareState.view(index); }
                reveal(index) => { ShareState.reveal(index); }
                remove(index) => { ShareState.remove(index); }
            }
        }
        VerticalLayout {
            spacing: 5px;
            Text { text: ShareState.sharing && ShareState.reachable ? ShareState.status : I18n.share-footnote; color: ShareTheme.muted; font-size: 11px; wrap: word-wrap; min-width: 0px; }
            if ShareState.sharing && ShareState.has-other-addresses: Text {
                text: ShareState.other-addresses; font-size: 10px; color: ShareTheme.muted; wrap: word-wrap; min-width: 0px;
            }
        }
    }
}
