import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { PageHeader } from "../components/page_header.slint";
import { FileCard } from "../components/file_card.slint";
import { SourcePanel } from "../components/source_panel.slint";
import { Badge } from "../components/badge.slint";
import { DocumentsState } from "../state/documents.slint";
export component DocumentsPage inherits VerticalLayout {
    in property <bool> busy;
    in property <bool> dragging;
    padding: Theme.page-padding; spacing: 20px;
    PageHeader { heading: I18n.documents-title; description: I18n.documents-description; badge: I18n.documents-badge; }
    FileCard {
        filename: DocumentsState.filename; detail: DocumentsState.detail;
        busy: root.busy; converting: DocumentsState.converting; dragging: root.dragging;
        choose => { DocumentsState.choose(); }
    }
    HorizontalLayout {
        spacing: 7px;
        Text { text: I18n.formats; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        for label in ["Word", "Excel", "PowerPoint", "PDF", "EPUB", "RTF", "CSV", "ODF"]: Badge { label: label; }
        Rectangle { horizontal-stretch: 1; }
    }
    SourcePanel {
        vertical-stretch: 1; min-height: 180px;
        title: "Markdown";
        caption: I18n.source;
        save-label: I18n.export;
        empty-heading: DocumentsState.converting ? I18n.converting-title : I18n.empty-title;
        empty-description: DocumentsState.converting ? I18n.converting-hint : I18n.empty-hint;
        lines: DocumentsState.markdown-lines;
        stats: DocumentsState.stats;
        has-result: DocumentsState.has-result;
        busy: root.busy;
        copy => { DocumentsState.copy(); }
        save => { DocumentsState.save(); }
    }
    Text { text: I18n.documents-footnote; color: Theme.muted; font-size: 11px; wrap: word-wrap; min-width: 0px; }
}
