import { Theme } from "../theme.slint";

// Share-page geometry, using the toolbox's original blue-gray palette.
export global ShareTheme {
    out property <color> canvas: Theme.canvas;
    out property <color> ink: Theme.ink;
    out property <color> muted: Theme.muted;
    out property <color> border: Theme.border;
    out property <color> tint: Theme.tint;
    out property <color> accent: Theme.accent;
    out property <color> hero: Theme.accent;
    out property <color> hero-muted: #cdd7e4;
    out property <length> radius: 16px;
}
