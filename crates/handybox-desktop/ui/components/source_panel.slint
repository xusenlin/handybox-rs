import { I18n } from "../i18n.slint";
import { CodeView } from "code_view.slint";
import { Theme } from "../theme.slint";
import { Action } from "action.slint";
import { EmptyState } from "empty_state.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";

// Read-only result surface shared by the tools that produce text: a titled card
// with copy/export actions, a virtualized source view and a stats footer.
export component SourcePanel inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <string> save-label;
    in property <[string]> lines;
    in property <string> stats;
    in property <bool> has-result;
    in property <bool> busy;
    in property <image> icon: Icons.code;
    /// A tool whose real output is a file it already wrote has nothing to
    /// export from here, and an export button that saves the report instead
    /// would be a different thing wearing the same label.
    in property <bool> can-save: true;
    in property <string> empty-icon-key;
    in property <string> empty-heading;
    in property <string> empty-description;
    callback copy();
    callback save();
    border-radius: Theme.radius; border-width: 1px; border-color: Theme.border; background: Theme.surface;
    VerticalLayout {
        padding: 18px; spacing: 15px;
        HorizontalLayout {
            spacing: 9px;
            Icon { source: root.icon; ink: Theme.accent; width: 18px; }
            Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
            Text { text: root.caption; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; min-width: 0px; }
            Rectangle { horizontal-stretch: 1; }
            Action { label: I18n.copy; icon: Icons.copy; enabled: root.has-result && !root.busy; clicked => { root.copy(); } }
            if root.can-save: Action { label: root.save-label; icon: Icons.download; enabled: root.has-result && !root.busy; clicked => { root.save(); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if !root.has-result: EmptyState {
            tool-key: root.empty-icon-key;
            heading: root.empty-heading;
            description: root.empty-description;
            vertical-stretch: 1;
        }
        if root.has-result: CodeView {
            lines: root.lines; vertical-stretch: 1;
        }
        if root.has-result: Text {
            text: root.stats;
            color: Theme.muted; font-size: 10px; wrap: word-wrap;
            // Wrap instead of widening the panel: see JsonInput's status line.
            min-width: 0px;
        }
    }
}
