import { ListView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { Action } from "action.slint";
import { EmptyState } from "empty_state.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";
import { DiffRow } from "../types.slint";

// The comparison itself: a titled card with copy/export actions and one row per
// line, tinted by what happened to it.
//
// Like CodeView, the `for` is the direct child of the ListView, which is what
// compiles it into a virtualized repeater; nest it any deeper and every row is
// instantiated again. Each row carries its own line numbers, so the gutter is
// part of the row rather than a second column that would have to scroll in step.
export component DiffPanel inherits Rectangle {
    in property <[DiffRow]> rows;
    in property <string> caption;
    in property <string> stats;
    in property <bool> has-result;
    in property <bool> has-changes;
    in property <bool> busy;
    callback copy();
    callback save();
    private property <length> row-height: 19px;
    private property <length> gutter: 40px;
    border-radius: Theme.radius; border-width: 1px; border-color: Theme.border; background: Theme.surface;
    VerticalLayout {
        padding: 18px; spacing: 15px;
        HorizontalLayout {
            spacing: 9px;
            Icon { source: Icons.diff; ink: Theme.accent; width: 18px; }
            Text { text: I18n.diff-result; font-size: 14px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
            Text { text: root.caption; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; min-width: 0px; }
            Rectangle { horizontal-stretch: 1; }
            // What leaves this panel is the unified diff, so both actions are
            // about the changes: with nothing changed there is nothing to take.
            Action { label: I18n.diff-copy; icon: Icons.copy; enabled: root.has-changes && !root.busy; clicked => { root.copy(); } }
            Action { label: I18n.diff-export; icon: Icons.download; enabled: root.has-changes && !root.busy; clicked => { root.save(); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if !root.has-result: EmptyState {
            tool-key: "diff";
            heading: I18n.diff-empty-title;
            description: I18n.diff-empty-hint;
            vertical-stretch: 1;
        }
        if root.has-result: Rectangle {
            vertical-stretch: 1;
            ListView {
                x: 4px; y: 8px;
                width: parent.width - 8px; height: parent.height - 16px;
                for row in root.rows: Rectangle {
                    width: parent.visible-width - 8px;
                    height: max(body.preferred-height, root.row-height);
                    background: row.kind == 1 ? Theme.added : row.kind == 2 ? Theme.removed : row.kind == 3 ? Theme.tint : transparent;
                    // Every child here sets its own x and y: a child of a
                    // Rectangle is centred on both axes otherwise.
                    Text {
                        x: 0; y: 0; width: root.gutter; height: root.row-height;
                        text: row.old-line;
                        horizontal-alignment: right; vertical-alignment: center;
                        font-family: Theme.mono-family; font-size: 11px; color: Theme.muted;
                    }
                    Text {
                        x: root.gutter + 8px; y: 0; width: root.gutter; height: root.row-height;
                        text: row.new-line;
                        horizontal-alignment: right; vertical-alignment: center;
                        font-family: Theme.mono-family; font-size: 11px; color: Theme.muted;
                    }
                    // The marker, not the tint, is what states the change: a
                    // pale background is not something everyone can read.
                    Text {
                        x: root.gutter * 2 + 18px; y: 0; width: 12px; height: root.row-height;
                        text: row.kind == 1 ? "+" : row.kind == 2 ? "-" : "";
                        horizontal-alignment: center; vertical-alignment: center;
                        font-family: Theme.mono-family; font-size: 13px; font-weight: 700;
                        color: row.kind == 1 ? Theme.success : Theme.error;
                    }
                    body := Text {
                        x: root.gutter * 2 + 34px; y: 0;
                        width: parent.width - self.x;
                        text: row.text;
                        wrap: word-wrap;
                        font-family: Theme.mono-family; font-size: 13px;
                        color: row.kind == 3 ? Theme.muted : Theme.ink;
                        font-italic: row.kind == 3;
                    }
                }
            }
        }
        if root.has-result: Text {
            text: root.stats;
            color: Theme.muted; font-size: 10px; wrap: word-wrap;
            // Wrap instead of widening the panel: see the page's status line.
            min-width: 0px;
        }
    }
}
