import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { Action } from "action.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";
export component FileCard inherits Rectangle {
    in property <string> filename;
    in property <string> detail;
    in property <bool> busy;
    in property <bool> converting;
    in property <bool> dragging;
    callback choose();
    height: 96px;
    border-radius: Theme.radius;
    border-width: 1px; border-color: root.dragging ? Theme.accent : Theme.border;
    background: root.dragging ? Theme.tint : Theme.surface;
    // Keep the progress bar inside the rounded corners.
    clip: true;

    // Only conversion gets a bar. Copy is instant, and export/browse are spent
    // waiting on a native dialog, where a progress bar would be a lie.
    // Conversion reports no percentage, so the bar only signals that work is in
    // flight: a timer flips the target and the animation slides between them.
    private property <bool> sweep: false;
    Timer {
        interval: 900ms; running: root.converting;
        triggered => { root.sweep = !root.sweep; }
    }
    if root.converting: Rectangle {
        x: 0; y: parent.height - 3px; width: parent.width; height: 3px;
        background: Theme.tint;
        Rectangle {
            x: root.sweep ? parent.width - self.width : 0px;
            y: 0; width: parent.width * 30%; height: parent.height;
            background: Theme.accent;
            animate x { duration: 900ms; easing: ease-in-out; }
        }
    }
    // A fixed-size child is not centred on the cross axis, so the tile and the
    // button are wrapped to line up with the centred text between them. Only the
    // text takes the leftover width; the button keeps its natural size.
    HorizontalLayout {
        padding-left: 23px; padding-right: 23px;
        padding-top: 16px; padding-bottom: 16px;
        spacing: 17px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 52px; height: 58px; border-radius: 10px; background: Theme.tint;
                Icon { source: root.filename == "" ? Icons.file-import : Icons.document; ink: Theme.accent; width: 28px; height: 28px; x: 12px; y: 15px; }
            }
        }
        VerticalLayout {
            spacing: 8px; alignment: center; horizontal-stretch: 1;
            Text { text: root.dragging ? I18n.drop : root.filename == "" ? I18n.choose : root.filename; color: Theme.ink; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.detail; color: Theme.muted; font-size: 11px; wrap: word-wrap; overflow: elide; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Action { label: root.converting ? I18n.working : root.filename == "" ? I18n.browse : I18n.change-file; icon: root.converting ? Icons.clock : Icons.folder; primary: true; enabled: !root.busy; clicked => { root.choose(); } }
        }
    }
}
