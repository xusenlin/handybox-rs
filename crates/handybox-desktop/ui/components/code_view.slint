import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// Read-only source, one row per line.
//
// A single Text holding the whole document freezes the UI: femtovg shapes the
// entire string to measure it, its shaped-word cache holds 1000 entries, and
// Chinese has no word breaks — so a 26k-character document thrashes the cache and
// re-parses a 64 MiB fallback face per word. A `for` directly inside a ListView is
// compiled into a virtualised repeater, so only the visible rows are ever shaped,
// and the cost stops depending on how long the document is.
export component CodeView inherits Rectangle {
    in property <[string]> lines;
    // Blank lines carry structure in Markdown, so keep them a full row tall.
    private property <length> row-height: 19px;
    background: Theme.surface;

    ListView {
        x: 4px; y: 8px;
        width: parent.width - 8px; height: parent.height - 16px;
        for line in root.lines: Text {
            text: line;
            width: parent.visible-width - 8px;
            height: max(self.preferred-height, root.row-height);
            wrap: word-wrap;
            font-family: Theme.mono-family;
            font-size: 13px;
            color: Theme.ink;
        }
    }
}
