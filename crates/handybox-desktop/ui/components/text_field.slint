import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

// One-line input with a leading icon. Used for the sidebar search, the jq filter
// and the secrets on the crypto page; `mono` is the only difference between a
// phrase and an expression, and `password` masks what is typed.
export component TextField inherits Rectangle {
    in property <bool> enabled: true;
    in property <image> icon;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> mono: false;
    in property <bool> password: false;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted();
    height: 36px;
    background: input.has-focus ? Theme.surface : Theme.canvas;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 8px;
        Icon { source: root.icon; width: 15px; }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                enabled: root.enabled;
                width: parent.width; height: parent.height;
                single-line: true; vertical-alignment: center;
                color: Theme.ink; font-size: 12px;
                font-family: root.mono ? Theme.mono-family : Theme.font-family;
                input-type: root.password ? InputType.password : InputType.text;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            // Span the field and align left: a child of a Rectangle is centred
            // by default, which would leave the hint floating mid-field.
            if input.text == "": Text {
                text: root.placeholder; color: Theme.muted; font-size: 12px;
                font-family: root.mono ? Theme.mono-family : Theme.font-family;
                x: 0; width: parent.width; height: parent.height;
                vertical-alignment: center; horizontal-alignment: left;
            }
        }
    }
}
