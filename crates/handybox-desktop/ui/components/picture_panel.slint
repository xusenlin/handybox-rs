import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { EmptyState } from "empty_state.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";
import { DetailRow } from "../types.slint";

component Fact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px; padding-bottom: 14px;
    Text { text: root.label; color: Theme.muted; font-size: 10px; }
    Text { text: root.value; color: Theme.ink; font-size: 12px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
}

export component PicturePanel inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <bool> loading;
    in property <string> filename;
    in property <[DetailRow]> facts;
    in property <[DetailRow]> details;
    in property <bool> has-details;
    in property <string> note;
    border-radius: Theme.radius; border-width: 1px; border-color: Theme.border; background: Theme.surface;
    VerticalLayout {
        padding: 16px; spacing: 14px;
        HorizontalLayout {
            spacing: 8px; height: 24px;
            Icon { source: Icons.image; ink: Theme.accent; width: 18px; }
            Text { text: I18n.images-preview; font-size: 14px; font-weight: 700; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
            Text { text: root.filename; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.filename == "" && !root.loading: EmptyState {
            tool-key: "images"; heading: I18n.images-empty-title;
            description: I18n.images-empty-hint; vertical-stretch: 1;
        }
        if root.filename != "" || root.loading: HorizontalLayout {
            spacing: 16px; vertical-stretch: 1;
            Rectangle {
                horizontal-stretch: 1; min-width: 0px;
                background: Theme.canvas; border-radius: 8px; clip: true;
                if root.has-image: Image {
                    x: 12px; y: 12px; width: max(0px, parent.width - 24px); height: max(0px, parent.height - 24px);
                    source: root.source; image-fit: contain;
                }
                if !root.has-image: VerticalLayout {
                    padding: 20px; alignment: center; spacing: 10px;
                    Icon { source: root.loading ? Icons.clock : Icons.image; width: 28px; height: 28px; }
                    Text {
                        text: root.loading ? I18n.images-loading : I18n.images-preview-unavailable;
                        font-size: 12px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; min-width: 0px;
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle {
                width: 164px;
                ScrollView {
                    width: parent.width; height: parent.height;
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        width: parent.visible-width; padding-right: 8px; spacing: 0px;
                        Text { text: I18n.images-details; font-size: 12px; font-weight: 700; color: Theme.ink; }
                        Rectangle { height: 16px; }
                        for row in root.facts: Fact { label: row.label; value: row.value; }
                        if root.has-details: Rectangle { height: 1px; background: Theme.border; }
                        if root.has-details: Text { text: "EXIF"; color: Theme.muted; font-size: 10px; height: 34px; vertical-alignment: center; }
                        for row in root.details: Fact { label: row.label; value: row.value; }
                        if root.has-image: Text {
                            text: root.has-details ? root.note : I18n.images-no-exif;
                            color: Theme.muted; font-size: 10px; wrap: word-wrap; min-width: 0px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}
