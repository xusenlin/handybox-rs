import { I18n } from "../i18n.slint";
import { ShareAction } from "share_action.slint";
import { ShareTheme } from "share_theme.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";

// The connection address gets the full page width, with the QR beside it.
export component AddressCard inherits Rectangle {
    in property <bool> sharing;
    in property <bool> reachable;
    in property <string> address;
    in property <image> qr;
    in property <bool> has-qr;
    in property <string> status;
    callback copy-address();
    callback open-browser();
    border-radius: ShareTheme.radius;
    background: ShareTheme.hero;
    vertical-stretch: 0;

    VerticalLayout {
        padding: 22px; spacing: 16px;
        HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                horizontal-stretch: 1; alignment: center; spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Icon { source: Icons.share; ink: ShareTheme.hero-muted; width: 16px; }
                    Text { text: I18n.share-address-label; font-size: 11px; font-weight: 600; color: ShareTheme.hero-muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.sharing ? root.address : I18n.share-idle-title;
                    font-size: root.sharing ? 25px : 22px; font-weight: 700; color: white;
                    wrap: word-wrap; min-width: 0px;
                }
                Text {
                    text: root.sharing && root.reachable ? I18n.share-scan-hint : root.status;
                    font-size: 12px; color: root.reachable ? ShareTheme.hero-muted : #ffcabd;
                    wrap: word-wrap; min-width: 0px;
                }
            }
            // Keep the QR's native pixels and white quiet zone for reliable scans.
            if root.sharing && root.has-qr: VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: root.qr.width * 1px + 8px; height: root.qr.height * 1px + 8px;
                    border-radius: 10px; background: white;
                    Image { x: 4px; y: 4px; source: root.qr; width: root.qr.width * 1px; height: root.qr.height * 1px; image-fit: contain; }
                }
            }
            if root.sharing: VerticalLayout {
                alignment: center; spacing: 10px; horizontal-stretch: 0;
                ShareAction { label: I18n.share-open-browser; icon: Icons.external; on-dark: true; horizontal-stretch: 1; clicked => { root.open-browser(); } }
                ShareAction { label: I18n.share-copy-address; icon: Icons.copy; horizontal-stretch: 1; clicked => { root.copy-address(); } }
            }
        }
    }
}
