import { I18n } from "../i18n.slint";
import { CodeView } from "code_view.slint";
import { Theme } from "../theme.slint";
import { Action } from "action.slint";
import { EmptyState } from "empty_state.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";
export component MarkdownPanel inherits Rectangle {
    in property <[string]> markdown-lines;
    in property <string> stats;
    in property <bool> has-result;
    in property <bool> busy;
    in property <bool> converting;
    in property <bool> truncated;
    callback copy();
    callback save();
    border-radius: Theme.radius; border-width: 1px; border-color: Theme.border; background: Theme.surface;
    VerticalLayout {
        padding: 18px; spacing: 15px;
        HorizontalLayout {
            spacing: 9px;
            Icon { source: Icons.code; ink: Theme.accent; width: 18px; }
            Text { text: "Markdown"; font-size: 14px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
            Text { text: I18n.source; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Action { label: I18n.copy; icon: Icons.copy; enabled: root.has-result && !root.busy; clicked => { root.copy(); } }
            Action { label: I18n.export; icon: Icons.download; enabled: root.has-result && !root.busy; clicked => { root.save(); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if !root.has-result: EmptyState {
            heading: root.converting ? I18n.converting-title : I18n.empty-title;
            description: root.converting ? I18n.converting-hint : I18n.empty-hint;
            vertical-stretch: 1;
        }
        if root.has-result: CodeView {
            lines: root.markdown-lines; vertical-stretch: 1;
        }
        if root.has-result: Text {
            text: root.stats + (root.truncated ? I18n.truncated : "");
            color: Theme.muted; font-size: 10px; wrap: word-wrap;
        }
    }
}
