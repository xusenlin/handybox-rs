export global Theme {
    in-out property <string> font-family: "sans-serif";
    in-out property <string> mono-family: "monospace";
    out property <color> canvas: #f6f8fa;
    out property <color> surface: #ffffff;
    out property <color> ink: #263852;
    out property <color> muted: #6f7e88;
    out property <color> border: #e2e8ec;
    out property <color> accent: #3c5273;
    out property <color> accent-hover: #2d405e;
    out property <color> tint: #edf1f7;
    out property <color> cream: #faf7e8;
    out property <color> success: #3f806b;
    out property <color> error: #aa3737;
    // Backgrounds for a changed line. Pale enough that monospace text on top of
    // them keeps its contrast, and distinguishable by lightness as well as hue,
    // because the marker column is what carries the meaning for anyone who
    // cannot tell the two apart by colour.
    out property <color> added: #e7f3ec;
    out property <color> removed: #fbeaea;
    out property <length> radius: 12px;
    out property <length> gap: 16px;
    out property <length> page-padding: 30px;
    out property <length> small: 12px;
    out property <length> body: 14px;
}
