// Static UI copy. Rust updates chinese; every binding reacts in place.
export global I18n {
    in-out property <bool> chinese: false;
    out property <string> window-title: chinese ? "HandyBox — 本地工具箱" : "HandyBox — Your local toolkit";
    out property <string> brand-tagline: chinese ? "日常所需，触手可及" : "YOUR EVERYDAY TOOLKIT";
    out property <string> mascot: chinese ? "HandyBox 吉祥物" : "HandyBox mascot";
    out property <string> search: chinese ? "搜索工具" : "Search tools";
    out property <string> settings: chinese ? "设置" : "Settings";
    out property <string> language: chinese ? "语言" : "LANGUAGE";
    out property <string> search-placeholder: chinese ? "搜索工具…" : "Search tools…";
    out property <string> workspace: chinese ? "工作空间  /  10 个工具" : "WORKSPACE  /  10 TOOLS";
    out property <string> no-matches: chinese ? "没有匹配的工具" : "No matching tools";
    out property <string> local: chinese ? "专为本地处理设计" : "Local by design";
    out property <string> built-with: chinese ? "HandyBox v0.1.0  ·  使用 Slint 构建" : "HandyBox v0.1.0  ·  Built with Slint";
    out property <string> status-note: chinese ? "文档在本机处理，不联网、不上传" : "Processed on your device. No network, no uploads";
    out property <string> source: chinese ? " / 源码" : " / SOURCE";
    out property <string> copy: chinese ? "复制全文" : "Copy all";
    out property <string> export: chinese ? "导出 .md" : "Export .md";
    out property <string> converting-title: chinese ? "正在处理文档…" : "Working on your document…";
    out property <string> empty-title: chinese ? "让内容焕然一新" : "A fresh start for your content";
    out property <string> converting-hint: chinese ? "转换在后台进行，你可以继续浏览其他工具。" : "Conversion runs in the background. Feel free to explore other tools.";
    out property <string> empty-hint: chinese ? "Markdown 将显示在这里，随时可以复制或导出。\n选择一份文档，即可开始。" : "Your Markdown will appear here, ready to copy or export.\nChoose a document to get started.";
    out property <string> drop: chinese ? "松开以转换文档" : "Drop to convert your document";
    out property <string> choose: chinese ? "选择文档，或将文件拖到这里" : "Choose a document or drop it here";
    out property <string> working: chinese ? "处理中…" : "Working…";
    out property <string> browse: chinese ? "选择文件" : "Browse files";
    out property <string> change-file: chinese ? "更换文件" : "Change file";
    out property <string> documents-title: chinese ? "文档转换" : "Document converter";
    out property <string> documents-description: chinese ? "将日常办公文档转换为清晰、易用的 Markdown。" : "From everyday documents to clean, portable Markdown.";
    // Keep the label within the active UI font's coverage: U+2192 is absent from
    // Helvetica Neue and would force a font-fallback query on every frame.
    out property <string> documents-badge: chinese ? "文档 → Markdown" : "DOCUMENT TO MARKDOWN";
    out property <string> formats: chinese ? "支持格式" : "FORMATS";
    out property <string> documents-footnote: chinese ? "所有处理均在本机完成  ·  单文件最大 64 MiB  ·  扫描 PDF 需要 OCR（暂不支持）" : "Processed on your device  ·  Up to 64 MiB per file  ·  Scanned PDFs require OCR (not included)";
    // JSON workbench. Expressions and the filter placeholder stay ASCII: they are
    // shown in the monospace family, which has no CJK coverage. The button
    // labels are short because this page puts two cards of actions side by side.
    out property <string> json-title: chinese ? "JSON 工作台" : "JSON workbench";
    out property <string> json-description: chinese ? "校验、格式化，并用 jq 表达式查询结构化数据。" : "Validate, format and query structured data with jq expressions.";
    out property <string> json-badge: chinese ? "JSON 与 jq" : "JSON AND JQ";
    out property <string> json-input: chinese ? "输入" : "Input";
    out property <string> json-unsaved: chinese ? "临时文档" : "Scratch document";
    out property <string> json-placeholder: chinese ? "在此粘贴 JSON，或打开文件、载入示例。" : "Paste JSON here, or open a file or the sample.";
    out property <string> json-open: chinese ? "打开文件" : "Open";
    out property <string> json-sample: chinese ? "示例" : "Sample";
    out property <string> json-clear: chinese ? "清空" : "Clear";
    out property <string> json-filter: chinese ? "jq 表达式" : "jq filter";
    out property <string> json-filter-placeholder: ".tools[] | .key";
    out property <string> json-run: chinese ? "运行" : "Run";
    out property <string> json-minify: chinese ? "压缩" : "Minify";
    out property <string> json-strict: chinese ? "严格（单个值）" : "Strict (one value)";
    out property <string> json-result: chinese ? "结果" : "Result";
    out property <string> json-result-caption: chinese ? " / JSON" : " / JSON";
    out property <string> json-running: chinese ? " / 正在运行…" : " / Running…";
    out property <string> json-export: chinese ? "导出 .json" : "Export";
    out property <string> json-empty-title: chinese ? "结构化数据，一目了然" : "Structured data, made readable";
    out property <string> json-empty-hint: chinese ? "格式化结果会显示在这里，可复制或导出。\n留空表达式即为格式化整份文档。" : "Your formatted result appears here, ready to copy or export.\nLeave the filter empty to format the whole document.";
    out property <string> json-footnote: chinese ? "所有处理均在本机完成  ·  单份文档最大 4 MiB  ·  jq 语法由 jaq 提供  ·  最多输出 20000 条或运行 5 秒" : "Processed on your device  ·  Up to 4 MiB per document  ·  jq syntax provided by jaq  ·  Results stop at 20,000 outputs or 5 seconds";
    // Hash & encrypt. Key material and digests are shown in the monospace
    // family, so the placeholders that show their shape stay ASCII.
    out property <string> crypto-title: chinese ? "哈希与加密" : "Hash & encrypt";
    out property <string> crypto-description: chinese ? "校验文件完整性，用 age 加密和解密本地文件。" : "Verify what a file is, and encrypt or decrypt it with age.";
    out property <string> crypto-badge: chinese ? "SHA-2 与 age" : "SHA-2 AND AGE";
    out property <string> crypto-checksum: chinese ? "校验和" : "Checksum";
    out property <string> crypto-encrypt: chinese ? "加密" : "Encrypt";
    out property <string> crypto-decrypt: chinese ? "解密" : "Decrypt";
    out property <string> crypto-choose: chinese ? "选择文件，或将文件拖到这里" : "Choose a file or drop it here";
    out property <string> crypto-drop: chinese ? "松开以处理该文件" : "Drop to work on this file";
    out property <string> crypto-browse: chinese ? "选择文件" : "Browse files";
    out property <string> crypto-change: chinese ? "更换文件" : "Change file";
    out property <string> crypto-hint: chinese ? "任何文件都可以计算摘要、加密或解密" : "Any file can be hashed, encrypted or decrypted";
    out property <string> crypto-expected: chinese ? "期望校验和" : "Expected checksum";
    out property <string> crypto-expected-placeholder: chinese ? "粘贴 SHA-256 或 SHA-512 校验和进行比对（可留空）" : "Paste a SHA-256 or SHA-512 checksum to verify (optional)";
    out property <string> crypto-passphrase: chinese ? "密码" : "Passphrase";
    out property <string> crypto-passphrase-placeholder: chinese ? "用于保护该文件的密码" : "The passphrase that protects this file";
    out property <string> crypto-recipients: chinese ? "接收者公钥" : "Recipient public keys";
    out property <string> crypto-recipients-placeholder: "age1…  (one per line, or separated by spaces)";
    out property <string> crypto-identity: chinese ? "私钥" : "Secret key";
    out property <string> crypto-identity-placeholder: "AGE-SECRET-KEY-1…";
    out property <string> crypto-use-key: chinese ? "使用公钥" : "Use a public key";
    out property <string> crypto-use-identity: chinese ? "使用私钥" : "Use a secret key";
    out property <string> crypto-reveal: chinese ? "显示" : "Show";
    out property <string> crypto-generate: chinese ? "生成密钥对" : "Generate key pair";
    out property <string> crypto-compute: chinese ? "计算" : "Compute";
    out property <string> crypto-result: chinese ? "结果" : "Result";
    out property <string> crypto-empty-title: chinese ? "先确认它是什么" : "Know what a file is";
    out property <string> crypto-empty-hint: chinese ? "摘要、校验结果与加解密报告会显示在这里。\n选择一个文件即可开始。" : "Digests, verification results and encryption reports appear here.\nChoose a file to get started.";
    out property <string> crypto-checksum-note: chinese ? "一次读取同时得到两种摘要；粘贴的校验和按长度自动判断算法。" : "Both digests come from one pass, and a pasted checksum names its own algorithm.";
    out property <string> crypto-passphrase-note: chinese ? "密码模式使用 scrypt，加密和解密各需约一秒；密码丢失即无法恢复。" : "Passphrase mode uses scrypt and costs about a second each way. A lost passphrase cannot be recovered.";
    out property <string> crypto-key-note: chinese ? "文件加密给这些公钥，只有持有对应私钥的人才能打开。" : "The file is encrypted to these public keys; only the matching secret key opens it.";
    out property <string> crypto-identity-note: chinese ? "使用生成密钥对时保存的私钥。" : "Use the secret key you saved when the key pair was generated.";
    out property <string> crypto-footnote: chinese ? "所有处理均在本机完成  ·  单个文件最大 2 GiB  ·  摘要由 sha2 提供，加密由 age 提供  ·  开始后无法中断" : "Processed on your device  ·  Up to 2 GiB per file  ·  Digests by sha2, encryption by age  ·  An operation cannot be interrupted once it starts";
    // Text diff. The comparison is live, so nothing here names a Compare action;
    // the labels that remain are about the two sides and what leaves the panel.
    out property <string> diff-title: chinese ? "文本对比" : "Text diff";
    out property <string> diff-description: chinese ? "逐行对比两段文本或两个文件，找出改动的地方。" : "Compare two texts or two files line by line, and see what changed.";
    out property <string> diff-badge: chinese ? "逐行差异" : "LINE BY LINE";
