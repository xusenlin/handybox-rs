    out property <string> cleanup-trash: chinese ? "移到回收站…" : "Move to trash…";
    out property <string> cleanup-cancel: chinese ? "取消" : "Cancel";
    out property <string> cleanup-confirm: chinese ? "确认移动" : "Yes, move them";
    out property <string> cleanup-empty-title: chinese ? "先看看里面有什么" : "Start by looking";
    out property <string> cleanup-empty-hint: chinese ? "扫描结果会显示在这里，逐条勾选后才会动文件。\n选择一个文件夹，扫描会自动开始。" : "What the scan finds appears here, and nothing moves until you tick it.\nChoose a folder, and the scan starts on its own.";
    out property <string> cleanup-footnote: chinese ? "全部在本机扫描  ·  单次最多 20 万个文件 / 读取 16 GiB / 60 秒  ·  重复只按内容判断  ·  跳过 .git 等版本库与系统目录  ·  不跟随符号链接  ·  删除即移入系统回收站，可还原" : "Scanned on your device  ·  Up to 200,000 files, 16 GiB read and 60 seconds per scan  ·  Duplicates are decided by content alone  ·  Version control and system folders are skipped  ·  Links are never followed  ·  What goes, goes to the system trash and can be put back";
    // Archives. Format names are what is printed on every other tool's menu and
    // stay as they are; everything about what happens to the files is
    // translated. The wording keeps saying what is not touched, because
    // unpacking into a folder you already work in is where surprises live.
    out property <string> archives-title: chinese ? "压缩与解压" : "Archives";
    out property <string> archives-description: chinese ? "看清压缩包里有什么，取出需要的部分，或者把一个文件夹打包起来。" : "See what is inside an archive, take out the parts you need, or pack a folder into one.";
    out property <string> archives-badge: chinese ? "ZIP 与 7z" : "ZIP AND 7Z";
    out property <string> archives-open: chinese ? "打开压缩包" : "Open an archive";
    out property <string> archives-pack: chinese ? "新建压缩包" : "Create one";
    out property <string> archives-choose: chinese ? "选择压缩包，或把它拖到这里" : "Choose an archive or drop one here";
    out property <string> archives-drop: chinese ? "松开以读取该压缩包" : "Drop to read this archive";
    out property <string> archives-browse: chinese ? "选择压缩包" : "Browse archives";
    out property <string> archives-change: chinese ? "更换压缩包" : "Change archive";
    out property <string> archives-choose-folder: chinese ? "选择要压缩的文件夹，或把文件夹拖到这里" : "Choose a folder to pack, or drop one here";
    out property <string> archives-drop-folder: chinese ? "松开以列出其中的文件" : "Drop to list what is in it";
    out property <string> archives-browse-folder: chinese ? "选择文件夹" : "Choose folder";
    out property <string> archives-change-folder: chinese ? "更换文件夹" : "Change folder";
    out property <string> archives-contents: chinese ? "压缩包内容" : "Contents";
