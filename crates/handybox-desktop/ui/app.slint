import { I18n } from "i18n.slint";
import { Theme } from "theme.slint";
import { ToolItem } from "types.slint";
import { Sidebar } from "components/sidebar.slint";
import { StatusBar } from "components/status_bar.slint";
import { Toast } from "components/toast.slint";
import { DocumentsPage } from "pages/documents.slint";
import { PlaceholderPage } from "pages/placeholder.slint";
export { Theme, ToolItem, I18n }

// Application shell: route and compose. Tool layouts belong in pages/.
export component AppWindow inherits Window {
    title: I18n.window-title;
    icon: @image-url("../../../assets/app-icon.png");
    preferred-width: 1120px; preferred-height: 780px;
    min-width: 1000px; min-height: 700px;
    background: Theme.canvas;
    default-font-family: Theme.font-family;
    in property <[ToolItem]> tools;
    in property <ToolItem> current-tool;
    in property <string> filename;
    in property <string> file-detail: I18n.file-hint;
    in property <[string]> markdown-lines;
    in property <string> stats;
    in property <string> notice;
    in property <bool> notice-error;
    in property <string> repository;
    in property <bool> busy;
    in property <bool> converting;
    in property <bool> dragging;
    in property <bool> has-result;
    in property <bool> truncated;
    callback navigate(string);
    callback search-tools(string);
    callback language-selected(bool);
    callback choose-document();
    callback copy-markdown();
    callback save-markdown();
    callback open-repository();
    callback dismiss-notice();
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            Sidebar { tools: root.tools; selected-key: root.current-tool.key; navigate(key) => { root.navigate(key); } search(query) => { root.search-tools(query); } language-selected(chinese) => { root.language-selected(chinese); } }
            if root.current-tool.key == "documents": DocumentsPage {
                filename: root.filename; file-detail: root.file-detail; markdown-lines: root.markdown-lines; stats: root.stats;
                busy: root.busy; converting: root.converting; dragging: root.dragging; has-result: root.has-result; truncated: root.truncated;
                choose => { root.choose-document(); } copy => { root.copy-markdown(); } save => { root.save-markdown(); }
            }
            if root.current-tool.key != "documents": PlaceholderPage { tool: root.current-tool; open-documents => { root.navigate("documents"); } }
        }
        StatusBar { repository: root.repository; open-repository => { root.open-repository(); } }
    }
    // Sibling of the layout, so it overlays the page instead of displacing it.
    Toast {
        message: root.notice; error: root.notice-error;
        x: (root.width - self.width) / 2;
        base-y: root.height - 35px - self.height - 20px;
        dismissed => { root.dismiss-notice(); }
    }
}
