import { I18n } from "i18n.slint";
import { Theme } from "theme.slint";
import { ArchiveRow, CleanupRow, ClipItem, CodeSymbol, DetailRow, DiffRow, ShareRow, ToolItem } from "types.slint";
import { DocumentsState } from "state/documents.slint";
import { JsonState } from "state/json.slint";
import { CryptoState } from "state/crypto.slint";
import { DiffState } from "state/diff.slint";
import { CodesState } from "state/codes.slint";
import { ClipboardState } from "state/clipboard.slint";
import { CleanupState } from "state/cleanup.slint";
import { ImagesState } from "state/images.slint";
import { ArchivesState } from "state/archives.slint";
import { ShareState } from "state/share.slint";
import { Sidebar } from "components/sidebar.slint";
import { StatusBar } from "components/status_bar.slint";
import { Toast } from "components/toast.slint";
import { TextSheet } from "components/text_sheet.slint";
import { DocumentsPage } from "pages/documents.slint";
import { JsonPage } from "pages/json.slint";
import { CryptoPage } from "pages/crypto.slint";
import { DiffPage } from "pages/diff.slint";
import { CodesPage } from "pages/codes.slint";
import { ClipboardPage } from "pages/clipboard.slint";
import { CleanupPage } from "pages/cleanup.slint";
import { ImagesPage } from "pages/images.slint";
import { ArchivesPage } from "pages/archives.slint";
import { SharePage } from "pages/share.slint";
import { PlaceholderPage } from "pages/placeholder.slint";
export { Theme, ToolItem, DiffRow, CodeSymbol, ClipItem, CleanupRow, ArchiveRow, DetailRow, I18n, DocumentsState, JsonState, CryptoState, DiffState, CodesState, ClipboardState, CleanupState, ImagesState, ArchivesState, ShareState, ShareRow }

// Application shell: route and compose. A tool's own state lives in its global
// (state/), its layout in pages/. The shell owns only what every tool shares.
export component AppWindow inherits Window {
    title: I18n.window-title;
    icon: @image-url("../../../assets/app-icon.png");
    preferred-width: 1200px; preferred-height: 800px;
    // The workbench gives each of its two cards half the page, and the wider of
    // the two headers (title plus three buttons) has to fit in that half.
    min-width: 1140px; min-height: 700px;
    background: Theme.canvas;
    default-font-family: Theme.font-family;
    in property <[ToolItem]> tools;
    in property <ToolItem> current-tool;
    in property <string> notice;
    in property <bool> notice-error;
    in property <bool> notice-long;
    in property <string> repository;
    in property <bool> busy;
    in property <bool> dragging;
    callback navigate(string);
    callback search-tools(string);
    callback language-selected(bool);
    callback open-repository();
    callback dismiss-notice();
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            Sidebar { tools: root.tools; selected-key: root.current-tool.key; navigate(key) => { root.navigate(key); } search(query) => { root.search-tools(query); } language-selected(chinese) => { root.language-selected(chinese); } }
            if root.current-tool.key == "documents": DocumentsPage { busy: root.busy; dragging: root.dragging; }
            if root.current-tool.key == "json": JsonPage { busy: root.busy; }
            if root.current-tool.key == "crypto": CryptoPage { busy: root.busy; dragging: root.dragging; }
            if root.current-tool.key == "diff": DiffPage { busy: root.busy; }
            if root.current-tool.key == "codes": CodesPage { busy: root.busy; dragging: root.dragging; }
            if root.current-tool.key == "clipboard": ClipboardPage { busy: root.busy; }
            if root.current-tool.key == "cleanup": CleanupPage { busy: root.busy; dragging: root.dragging; }
            if root.current-tool.key == "images": ImagesPage { busy: root.busy; dragging: root.dragging; }
            if root.current-tool.key == "archives": ArchivesPage { busy: root.busy; dragging: root.dragging; }
            if root.current-tool.key == "share": SharePage { busy: root.busy; dragging: root.dragging; }
            if !root.current-tool.available: PlaceholderPage { tool: root.current-tool; open-documents => { root.navigate("documents"); } }
        }
        StatusBar { repository: root.repository; open-repository => { root.open-repository(); } }
    }
    // Siblings of the layout, so they overlay the page instead of displacing
    // it. A page is a layout and cannot hold something that covers it.
    if ShareState.previewing: TextSheet {
        x: 0; y: 0; width: root.width; height: root.height;
        title: ShareState.preview-name;
        lines: ShareState.preview-lines;
        busy: root.busy;
        dismissed => { ShareState.close-preview(); }
        copy => { ShareState.copy-preview(); }
    }
    Toast {
        message: root.notice; error: root.notice-error; long: root.notice-long;
        x: (root.width - self.width) / 2;
        base-y: root.height - 35px - self.height - 20px;
        dismissed => { root.dismiss-notice(); }
    }
}
