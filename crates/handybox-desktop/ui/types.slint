export struct ToolItem {
    key: string,
    name: string,
    subtitle: string,
    libraries: string,
    capabilities: string,
    available: bool,
}

// One row of a comparison. `kind` is 0 unchanged, 1 added, 2 removed, 3 a gap
// standing in for unchanged lines that were left out. The line numbers are
// strings because a row only has one on the side it belongs to, and an empty
// gutter is what a missing number looks like.
export struct DiffRow {
    kind: int,
    old-line: string,
    new-line: string,
    text: string,
}

// One recognized code. The geometry is a fraction of the picture — 0 is its left
// or top edge, 1 the right or bottom one — so the same numbers place a marker
// over a preview of any size. `index` is a string because it is only ever shown,
// beside the row and on the marker that ties the two together.
export struct CodeSymbol {
    index: string,
    format: string,
    text: string,
    detail: string,
    x: float,
    y: float,
    width: float,
    height: float,
}
