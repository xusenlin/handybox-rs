export struct ToolItem {
    key: string,
    name: string,
    subtitle: string,
    libraries: string,
    capabilities: string,
    available: bool,
}

// One row of a comparison. `kind` is 0 unchanged, 1 added, 2 removed, 3 a gap
// standing in for unchanged lines that were left out. The line numbers are
// strings because a row only has one on the side it belongs to, and an empty
// gutter is what a missing number looks like.
export struct DiffRow {
    kind: int,
    old-line: string,
    new-line: string,
    text: string,
}

// One picture in the folder the image studio is looking at. `ticked` is whether
// a batch would write it and `shown` is whether it is the one on screen: two
// selections, because they answer different questions.
export struct ImageRow {
    name: string,
    detail: string,
    ticked: bool,
    shown: bool,
    index: int,
}

// One fact about a picture: what it is called in the display language, and what
// the camera actually recorded. Values are never translated.
export struct DetailRow {
    label: string,
    value: string,
}

// One row of a cleanup result. A header stands for a group of identical files
// and is not selectable, which is what `index: -1` means; every other row points
// back at the entry it came from, because the list the page shows and the list
// Rust holds are not the same length once headers are in it.
export struct CleanupRow {
    header: bool,
    label: string,
    detail: string,
    selected: bool,
    index: int,
}

// One line of an archive: an entry that is in it, or a file that would go into
// it. `refused` is a name this tool will not write — one that points outside the
// folder it would be unpacked into — and such a row can never be ticked, which
// is why it carries the flag rather than simply being left out of the list.
export struct ArchiveRow {
    name: string,
    detail: string,
    ticked: bool,
    refused: bool,
    directory: bool,
    index: int,
}

// One item in the clipboard workspace. `kind` is 0 text, 1 image, 2 file
// references; `label` is that kind in the display language. `id` is the
// workspace's own identifier rather than a row index, because with automatic
// collecting switched on the list can change between drawing a row and clicking
// it, and a row index would then point at something else.
export struct ClipItem {
    id: int,
    kind: int,
    label: string,
    summary: string,
    detail: string,
}

// One recognized code. The geometry is a fraction of the picture — 0 is its left
// or top edge, 1 the right or bottom one — so the same numbers place a marker
// over a preview of any size. `index` is a string because it is only ever shown,
// beside the row and on the marker that ties the two together.
export struct CodeSymbol {
    index: string,
    format: string,
    text: string,
    detail: string,
    x: float,
    y: float,
    width: float,
    height: float,
}
