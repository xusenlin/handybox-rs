// Embedded, original 24px SVGs. Recolor through Icon; no symbol fonts or network.
export global Icons {
    out property <image> document: @image-url("assets/icons/document.svg");
    out property <image> json: @image-url("assets/icons/json.svg");
    out property <image> lock: @image-url("assets/icons/lock.svg");
    out property <image> diff: @image-url("assets/icons/diff.svg");
    out property <image> image: @image-url("assets/icons/image.svg");
    out property <image> archive: @image-url("assets/icons/archive.svg");
    out property <image> scan: @image-url("assets/icons/scan.svg");
    out property <image> drive: @image-url("assets/icons/drive.svg");
    out property <image> clipboard: @image-url("assets/icons/clipboard.svg");
    out property <image> folder: @image-url("assets/icons/folder.svg");
    out property <image> file-import: @image-url("assets/icons/file-import.svg");
    out property <image> copy: @image-url("assets/icons/copy.svg");
    out property <image> download: @image-url("assets/icons/download.svg");
    out property <image> search: @image-url("assets/icons/search.svg");
    out property <image> shield: @image-url("assets/icons/shield.svg");
    out property <image> check-circle: @image-url("assets/icons/check-circle.svg");
    out property <image> alert: @image-url("assets/icons/alert.svg");
    out property <image> clock: @image-url("assets/icons/clock.svg");
    out property <image> arrow-right: @image-url("assets/icons/arrow-right.svg");
    out property <image> code: @image-url("assets/icons/code.svg");
    out property <image> settings: @image-url("assets/icons/settings.svg");
    out property <image> share: @image-url("assets/icons/share.svg");
    out property <image> play: @image-url("assets/icons/play.svg");
    out property <image> stop: @image-url("assets/icons/stop.svg");
    out property <image> external: @image-url("assets/icons/external.svg");
    out property <image> trash: @image-url("assets/icons/trash.svg");
    out property <image> eye: @image-url("assets/icons/eye.svg");
    // GitHub's own mark, used per their brand guidance to link to the repository.
    out property <image> github: @image-url("assets/icons/github.svg");
}
